) %>% select(Trading_Date, Expiry_Date, Ticker, MABXM_Return, Close_T)
trade_logs[[basename(f)]] <- log_df
}, error = function(e) NULL)
}
all_trade_logs <- bind_rows(trade_logs)
if(nrow(all_trade_logs) == 0) stop("❌ 成功找到檔案，但讀取內容失敗或為空！")
# ==============================================================================
# 5. 嚴格 30 檔驗證與三分排序 (Top10 / Mid10 / Bot10) =====
# ==============================================================================
message("正在進行嚴格身分驗證並切分 Top 10, Mid 10, Bot 10...")
unique_trade_dates <- sort(unique(all_trade_logs$Trading_Date))
portfolio_returns <- list()
not_30_dates <- c() # 紀錄不是 30 檔的日期
for (t_date in unique_trade_dates) {
t_date <- as.Date(t_date)
# (1) Point-in-Time 找當期有效成分股
past_reports <- dji_long %>% filter(Report_Date <= t_date)
if(nrow(past_reports) == 0) next
latest_report_date <- max(past_reports$Report_Date)
active_tickers <- past_reports %>% filter(Report_Date == latest_report_date) %>% pull(Ticker) %>% unique()
# (2) 獲取當期 MA 訊號，只留下「當期合法成分股」
t_signals <- ma_signals %>%
filter(Trade_Date == t_date, Ticker %in% active_tickers, !is.na(MA_Ratio)) %>%
arrange(desc(MA_Ratio))
# 👇【自動體檢機制】檢查是否剛好 30 檔
if(nrow(t_signals) != 30) {
not_30_dates <- c(not_30_dates, as.character(t_date))
}
if(nrow(t_signals) < 10) next
# 分成三組 (頭10, 尾10, 中間)
top10_tkrs <- t_signals$Ticker[1:10]
bot10_tkrs <- t_signals$Ticker[(nrow(t_signals)-9):nrow(t_signals)]
mid10_tkrs <- t_signals$Ticker[11:(nrow(t_signals)-10)]
# (3) 抓取當期個股報酬，計算「價格加權」投組報酬
t_logs <- all_trade_logs %>% filter(Trading_Date == t_date)
calc_pw_return <- function(tkrs) {
grp_data <- t_logs %>% filter(Ticker %in% tkrs)
if(nrow(grp_data) == 0) return(NA)
sum(grp_data$MABXM_Return * grp_data$Close_T, na.rm=TRUE) / sum(grp_data$Close_T, na.rm=TRUE)
}
exp_date <- max(t_logs$Expiry_Date, na.rm=TRUE)
portfolio_returns[[as.character(t_date)]] <- data.frame(
Start_Date = t_date, End_Date = exp_date,
MABXM_Top10 = calc_pw_return(top10_tkrs),
MABXM_Mid10 = calc_pw_return(mid10_tkrs),
MABXM_Bot10 = calc_pw_return(bot10_tkrs)
)
}
if(length(not_30_dates) > 0) {
message("⚠️ 提醒：有 ", length(not_30_dates), " 期的有效 MA 訊號並非剛好 30 檔（可能因停牌、剛上市無 MA180 等資料摩擦）。但程式已動態對齊。")
} else {
message("✅ 完美！經過驗證，每一期都是剛好 30 檔成分股！您是對的！")
}
df_port <- bind_rows(portfolio_returns) %>% filter(!is.na(MABXM_Top10))
# ==============================================================================
# 6. Fama-French 日資料完美對齊 =====
# ==============================================================================
message("正在進行 Fama-French 日資料區間對齊...")
ff3_raw <- readLines(path_ff3_daily)
ff3_start <- grep("Mkt-RF", ff3_raw)[1]
ff3_d <- read.csv(text = ff3_raw[ff3_start:length(ff3_raw)], stringsAsFactors = FALSE)
colnames(ff3_d)[1] <- "DateStr"
ff3_d <- ff3_d %>% filter(nchar(trimws(DateStr)) == 8) %>%
mutate(TradeDate = as.Date(trimws(DateStr), "%Y%m%d"), Mkt_RF = as.numeric(Mkt.RF)/100, SMB = as.numeric(SMB)/100, HML = as.numeric(HML)/100, RF = as.numeric(RF)/100) %>% select(TradeDate, Mkt_RF, SMB, HML, RF)
mom_raw <- readLines(path_mom_daily)
mom_start <- grep(",Mom", mom_raw)[1]
if(is.na(mom_start)) mom_start <- grep("Mom", mom_raw)[1]
mom_d <- read.csv(text = mom_raw[mom_start:length(mom_raw)], stringsAsFactors = FALSE)
colnames(mom_d)[1] <- "DateStr"
mom_d <- mom_d %>% filter(nchar(trimws(DateStr)) == 8) %>% mutate(TradeDate = as.Date(trimws(DateStr), "%Y%m%d"), UMD = as.numeric(Mom)/100) %>% select(TradeDate, UMD)
ff_daily <- inner_join(ff3_d, mom_d, by = "TradeDate")
aligned_factors <- df_port %>% rowwise() %>%
mutate(
period_data = list(ff_daily %>% filter(TradeDate > Start_Date & TradeDate <= End_Date)),
Mkt_RF = prod(1 + period_data$Mkt_RF) - 1, SMB = prod(1 + period_data$SMB) - 1,
HML = prod(1 + period_data$HML) - 1, UMD = prod(1 + period_data$UMD) - 1, RF = prod(1 + period_data$RF) - 1
) %>% select(-period_data) %>% ungroup()
# ==============================================================================
# 7. 跑 Carhart 迴歸並輸出 Word 精美表格 =====
# ==============================================================================
message("正在計算迴歸並生成精美 Word 報表...")
strategy_names <- c("MABXM_Top10", "MABXM_Mid10", "MABXM_Bot10")
final_reg_results <- list()
final_attributions <- list()
for (strat in strategy_names) {
df_reg <- aligned_factors %>% mutate(Strategy_Ret = as.numeric(.data[[strat]]), Portfolio_Excess_Return = Strategy_Ret - RF)
model <- lm(Portfolio_Excess_Return ~ Mkt_RF + SMB + HML + UMD, data = df_reg)
res <- tidy(model) %>% mutate(Strategy = strat) %>% select(Strategy, term, estimate, std.error, statistic, p.value)
final_reg_results[[strat]] <- res
mean_mkt <- mean(df_reg$Mkt_RF, na.rm=TRUE); mean_smb <- mean(df_reg$SMB, na.rm=TRUE)
mean_hml <- mean(df_reg$HML, na.rm=TRUE); mean_umd <- mean(df_reg$UMD, na.rm=TRUE)
attr <- data.frame(
Strategy = strat,
Source = c("Alpha (純粹超額報酬)", "Market (大盤風險)", "Size (規模因子)", "Value (價值因子)", "Momentum (動能因子)", "Total Excess Return (總超額報酬)"),
Beta = c(NA, coef(model)["Mkt_RF"], coef(model)["SMB"], coef(model)["HML"], coef(model)["UMD"], NA),
Mean_Factor_Ret = c(NA, mean_mkt, mean_smb, mean_hml, mean_umd, NA),
Contribution = c(coef(model)["(Intercept)"], coef(model)["Mkt_RF"]*mean_mkt, coef(model)["SMB"]*mean_smb, coef(model)["HML"]*mean_hml, coef(model)["UMD"]*mean_umd, mean(df_reg$Portfolio_Excess_Return, na.rm=TRUE))
)
final_attributions[[strat]] <- attr
}
reg_df <- bind_rows(final_reg_results); attr_df <- bind_rows(final_attributions)
my_doc <- read_docx()
my_doc <- body_add_par(my_doc, "MABXM 機制檢定：動能三等分組合迴歸分析", style = "heading 1")
for (strat in strategy_names) {
my_doc <- body_add_par(my_doc, paste("檢定投組：", strat), style = "heading 2")
my_doc <- body_add_par(my_doc, "表 1：四因子迴歸係數檢定", style = "Normal")
r_data <- reg_df %>% filter(Strategy == strat) %>%
mutate(
Significance = case_when(p.value<0.001 ~ "***", p.value<0.01 ~ "**", p.value<0.05 ~ "*", TRUE ~ ""),
p.value = formatC(p.value, format = "e", digits = 2),
estimate = round(estimate, 6), std.error = round(std.error, 6), statistic = round(statistic, 4)
) %>% select(term, estimate, std.error, statistic, p.value, Significance)
colnames(r_data) <- c("變數 (Term)", "係數估計值", "標準誤", "t 統計量", "p 值", "顯著性")
ft_reg <- flextable(r_data) %>% theme_vanilla() %>% bg(i = 1, part = "header", bg = "#2E75B6") %>% color(i = 1, part = "header", color = "white") %>% bold(part = "header") %>% align(align = "center", part = "all") %>% autofit()
my_doc <- body_add_flextable(my_doc, value = ft_reg)
my_doc <- body_add_par(my_doc, "註: *** p < 0.001, ** p < 0.01, * p < 0.05。", style = "Normal")
my_doc <- body_add_par(my_doc, "")
my_doc <- body_add_par(my_doc, "表 2：報酬歸因分析", style = "Normal")
a_data <- attr_df %>% filter(Strategy == strat) %>%
mutate(Beta = ifelse(is.na(Beta), "-", as.character(round(Beta, 6))), Mean_Factor_Ret = ifelse(is.na(Mean_Factor_Ret), "-", as.character(round(Mean_Factor_Ret, 6))), Contribution = round(Contribution, 6)) %>% select(Source, Beta, Mean_Factor_Ret, Contribution)
colnames(a_data) <- c("報酬來源 (Source)", "因子曝險 (Beta)", "因子平均報酬", "超額報酬貢獻")
ft_attr <- flextable(a_data) %>% theme_vanilla() %>% bg(i = 1, part = "header", bg = "#548235") %>% color(i = 1, part = "header", color = "white") %>% bold(part = "header") %>% align(align = "center", part = "all") %>% autofit()
my_doc <- body_add_flextable(my_doc, value = ft_attr)
my_doc <- body_add_break(my_doc)
}
print(my_doc, target = path_out_word)
# ==============================================================================
# MABXM 機制檢定：動能三等分 (Top 10 / Mid 10 / Bot 10) 四因子迴歸與 Word 報表
# ==============================================================================
# 1. 載入必要套件 =====
library(readxl)
library(dplyr)
library(tidyr)
library(lubridate)
library(stringr)
library(broom)
library(officer)
library(flextable)
library(magrittr)
# 2. 設定檔案路徑 (請確認您的路徑) =====
path_dji       <- "C:/Users/User/Desktop/Thesis_project/data_raw/DJI成分股名單.xls"
path_ma_csv    <- "C:/Users/User/Desktop/Thesis_project/FF/MABXM_Signals_DailyMA.xlsx"
path_opt_out   <- "C:/Users/User/Desktop/Thesis_project/Output_M100/全期間/Output_MABXM"
path_ff3_daily <- "C:/Users/User/Desktop/Thesis_project/FF/F-F_Research_Data_Factors_daily.csv"
path_mom_daily <- "C:/Users/User/Desktop/Thesis_project/FF/F-F_Momentum_Factor_daily.csv"
path_out_word  <- "C:/Users/User/Desktop/Thesis_project/MABXM_Mechanism_Test.docx"
# ==============================================================================
# 3. 讀取與處理 DJI 成分股歷史權重 =====
# ==============================================================================
message("正在讀取 DJI 成分股歷史變動表...")
dji_raw <- read_excel(path_dji)
equity_cols <- grep("% Of Equity", names(dji_raw), value = TRUE)
month_map <- c("Jan"="01","Feb"="02","Mar"="03","Apr"="04","May"="05","Jun"="06",
"Jul"="07","Aug"="08","Sep"="09","Oct"="10","Nov"="11","Dec"="12")
dji_long <- dji_raw %>%
select(Ticker = ticker, all_of(equity_cols)) %>%
pivot_longer(cols = -Ticker, names_to = "DateStr", values_to = "Weight") %>%
mutate(Weight = suppressWarnings(as.numeric(Weight))) %>%
filter(!is.na(Weight), Weight > 0) %>%
mutate(
CleanStr = gsub(" % Of Equity", "", DateStr),
CleanStr = gsub("\\.", "-", CleanStr)
) %>%
rowwise() %>%
mutate(
parts = list(strsplit(CleanStr, "-")[[1]]),
Report_Date = if(length(parts) >= 3 && parts[1] %in% names(month_map)) {
as.Date(paste0(parts[3], "-", month_map[parts[1]], "-", sprintf("%02d", as.numeric(parts[2]))))
} else { as.Date(NA) }
) %>%
ungroup() %>%
filter(!is.na(Report_Date))
# ==============================================================================
# 4. 讀取 MA 訊號並蒐集個股績效 =====
# ==============================================================================
message("正在讀取 MA 訊號與個股回測歷史紀錄...")
ma_signals <- read_excel(path_ma_csv) %>%
mutate(
Trade_Date = as.Date(Trade_Date),
Ticker = toupper(trimws(Ticker)),
MA_Ratio = MA20 / MA180
)
all_tickers_files <- list.files(path_opt_out, pattern = "^MABXM_.*\\.xlsx$", full.names = TRUE)
if(length(all_tickers_files) == 0) stop(paste("❌ 找不到 MABXM_XXX.xlsx 檔案，請檢查路徑：", path_opt_out))
trade_logs <- list()
for (f in all_tickers_files) {
tryCatch({
log_df <- read_excel(f, sheet = "Trade_Log") %>%
mutate(
Trading_Date = as.Date(Trading_Date), Expiry_Date = as.Date(Expiry_Date),
MABXM_Return = as.numeric(MABXM_Return), Close_T = as.numeric(Close_T)
) %>% select(Trading_Date, Expiry_Date, Ticker, MABXM_Return, Close_T)
trade_logs[[basename(f)]] <- log_df
}, error = function(e) NULL)
}
all_trade_logs <- bind_rows(trade_logs)
if(nrow(all_trade_logs) == 0) stop("❌ 成功找到檔案，但讀取內容失敗或為空！")
# ==============================================================================
# 5. 嚴格 30 檔驗證與三分排序 (Top10 / Mid10 / Bot10) =====
# ==============================================================================
message("正在進行嚴格身分驗證並切分 Top 10, Mid 10, Bot 10...")
unique_trade_dates <- sort(unique(all_trade_logs$Trading_Date))
portfolio_returns <- list()
not_30_dates <- c() # 紀錄不是 30 檔的日期
for (t_date in unique_trade_dates) {
t_date <- as.Date(t_date)
# (1) Point-in-Time 找當期有效成分股
past_reports <- dji_long %>% filter(Report_Date <= t_date)
if(nrow(past_reports) == 0) next
latest_report_date <- max(past_reports$Report_Date)
active_tickers <- past_reports %>% filter(Report_Date == latest_report_date) %>% pull(Ticker) %>% unique()
# (2) 獲取當期 MA 訊號，只留下「當期合法成分股」
t_signals <- ma_signals %>%
filter(Trade_Date == t_date, Ticker %in% active_tickers, !is.na(MA_Ratio)) %>%
arrange(desc(MA_Ratio))
# 👇【自動體檢機制】檢查是否剛好 30 檔
if(nrow(t_signals) != 30) {
not_30_dates <- c(not_30_dates, as.character(t_date))
}
if(nrow(t_signals) < 10) next
# 分成三組 (頭10, 尾10, 中間)
top10_tkrs <- t_signals$Ticker[1:10]
bot10_tkrs <- t_signals$Ticker[(nrow(t_signals)-9):nrow(t_signals)]
mid10_tkrs <- t_signals$Ticker[11:(nrow(t_signals)-10)]
# (3) 抓取當期個股報酬，計算「價格加權」投組報酬
t_logs <- all_trade_logs %>% filter(Trading_Date == t_date)
calc_pw_return <- function(tkrs) {
grp_data <- t_logs %>% filter(Ticker %in% tkrs)
if(nrow(grp_data) == 0) return(NA)
sum(grp_data$MABXM_Return * grp_data$Close_T, na.rm=TRUE) / sum(grp_data$Close_T, na.rm=TRUE)
}
exp_date <- max(t_logs$Expiry_Date, na.rm=TRUE)
portfolio_returns[[as.character(t_date)]] <- data.frame(
Start_Date = t_date, End_Date = exp_date,
MABXM_Top10 = calc_pw_return(top10_tkrs),
MABXM_Mid10 = calc_pw_return(mid10_tkrs),
MABXM_Bot10 = calc_pw_return(bot10_tkrs)
)
}
if(length(not_30_dates) > 0) {
message("⚠️ 提醒：有 ", length(not_30_dates), " 期的有效 MA 訊號並非剛好 30 檔（可能因停牌、剛上市無 MA180 等資料摩擦）。但程式已動態對齊。")
} else {
message("✅ 完美！經過驗證，每一期都是剛好 30 檔成分股！您是對的！")
}
df_port <- bind_rows(portfolio_returns) %>% filter(!is.na(MABXM_Top10))
# ==============================================================================
# 6. Fama-French 日資料完美對齊 =====
# ==============================================================================
message("正在進行 Fama-French 日資料區間對齊...")
ff3_raw <- readLines(path_ff3_daily)
ff3_start <- grep("Mkt-RF", ff3_raw)[1]
ff3_d <- read.csv(text = ff3_raw[ff3_start:length(ff3_raw)], stringsAsFactors = FALSE)
colnames(ff3_d)[1] <- "DateStr"
ff3_d <- ff3_d %>% filter(nchar(trimws(DateStr)) == 8) %>%
mutate(TradeDate = as.Date(trimws(DateStr), "%Y%m%d"), Mkt_RF = as.numeric(Mkt.RF)/100, SMB = as.numeric(SMB)/100, HML = as.numeric(HML)/100, RF = as.numeric(RF)/100) %>% select(TradeDate, Mkt_RF, SMB, HML, RF)
mom_raw <- readLines(path_mom_daily)
mom_start <- grep(",Mom", mom_raw)[1]
if(is.na(mom_start)) mom_start <- grep("Mom", mom_raw)[1]
mom_d <- read.csv(text = mom_raw[mom_start:length(mom_raw)], stringsAsFactors = FALSE)
colnames(mom_d)[1] <- "DateStr"
mom_d <- mom_d %>% filter(nchar(trimws(DateStr)) == 8) %>% mutate(TradeDate = as.Date(trimws(DateStr), "%Y%m%d"), UMD = as.numeric(Mom)/100) %>% select(TradeDate, UMD)
ff_daily <- inner_join(ff3_d, mom_d, by = "TradeDate")
aligned_factors <- df_port %>% rowwise() %>%
mutate(
period_data = list(ff_daily %>% filter(TradeDate > Start_Date & TradeDate <= End_Date)),
Mkt_RF = prod(1 + period_data$Mkt_RF) - 1, SMB = prod(1 + period_data$SMB) - 1,
HML = prod(1 + period_data$HML) - 1, UMD = prod(1 + period_data$UMD) - 1, RF = prod(1 + period_data$RF) - 1
) %>% select(-period_data) %>% ungroup()
# ==============================================================================
# 7. 跑 Carhart 迴歸並輸出 Word 精美表格 =====
# ==============================================================================
message("正在計算迴歸並生成精美 Word 報表...")
strategy_names <- c("MABXM_Top10", "MABXM_Mid10", "MABXM_Bot10")
final_reg_results <- list()
final_attributions <- list()
for (strat in strategy_names) {
df_reg <- aligned_factors %>% mutate(Strategy_Ret = as.numeric(.data[[strat]]), Portfolio_Excess_Return = Strategy_Ret - RF)
model <- lm(Portfolio_Excess_Return ~ Mkt_RF + SMB + HML + UMD, data = df_reg)
res <- tidy(model) %>% mutate(Strategy = strat) %>% select(Strategy, term, estimate, std.error, statistic, p.value)
final_reg_results[[strat]] <- res
mean_mkt <- mean(df_reg$Mkt_RF, na.rm=TRUE); mean_smb <- mean(df_reg$SMB, na.rm=TRUE)
mean_hml <- mean(df_reg$HML, na.rm=TRUE); mean_umd <- mean(df_reg$UMD, na.rm=TRUE)
attr <- data.frame(
Strategy = strat,
Source = c("Alpha (純粹超額報酬)", "Market (大盤風險)", "Size (規模因子)", "Value (價值因子)", "Momentum (動能因子)", "Total Excess Return (總超額報酬)"),
Beta = c(NA, coef(model)["Mkt_RF"], coef(model)["SMB"], coef(model)["HML"], coef(model)["UMD"], NA),
Mean_Factor_Ret = c(NA, mean_mkt, mean_smb, mean_hml, mean_umd, NA),
Contribution = c(coef(model)["(Intercept)"], coef(model)["Mkt_RF"]*mean_mkt, coef(model)["SMB"]*mean_smb, coef(model)["HML"]*mean_hml, coef(model)["UMD"]*mean_umd, mean(df_reg$Portfolio_Excess_Return, na.rm=TRUE))
)
final_attributions[[strat]] <- attr
}
reg_df <- bind_rows(final_reg_results); attr_df <- bind_rows(final_attributions)
my_doc <- read_docx()
my_doc <- body_add_par(my_doc, "MABXM 機制檢定：動能三等分組合迴歸分析", style = "heading 1")
for (strat in strategy_names) {
my_doc <- body_add_par(my_doc, paste("檢定投組：", strat), style = "heading 2")
my_doc <- body_add_par(my_doc, "表 1：四因子迴歸係數檢定", style = "Normal")
r_data <- reg_df %>% filter(Strategy == strat) %>%
mutate(
Significance = case_when(p.value<0.001 ~ "***", p.value<0.01 ~ "**", p.value<0.05 ~ "*", TRUE ~ ""),
p.value = formatC(p.value, format = "e", digits = 2),
estimate = round(estimate, 6), std.error = round(std.error, 6), statistic = round(statistic, 4)
) %>% select(term, estimate, std.error, statistic, p.value, Significance)
colnames(r_data) <- c("變數 (Term)", "係數估計值", "標準誤", "t 統計量", "p 值", "顯著性")
ft_reg <- flextable(r_data) %>% theme_vanilla() %>% bg(i = 1, part = "header", bg = "#2E75B6") %>% color(i = 1, part = "header", color = "white") %>% bold(part = "header") %>% align(align = "center", part = "all") %>% autofit()
my_doc <- body_add_flextable(my_doc, value = ft_reg)
my_doc <- body_add_par(my_doc, "註: *** p < 0.001, ** p < 0.01, * p < 0.05。", style = "Normal")
my_doc <- body_add_par(my_doc, "")
my_doc <- body_add_par(my_doc, "表 2：報酬歸因分析", style = "Normal")
a_data <- attr_df %>% filter(Strategy == strat) %>%
mutate(Beta = ifelse(is.na(Beta), "-", as.character(round(Beta, 6))), Mean_Factor_Ret = ifelse(is.na(Mean_Factor_Ret), "-", as.character(round(Mean_Factor_Ret, 6))), Contribution = round(Contribution, 6)) %>% select(Source, Beta, Mean_Factor_Ret, Contribution)
colnames(a_data) <- c("報酬來源 (Source)", "因子曝險 (Beta)", "因子平均報酬", "超額報酬貢獻")
ft_attr <- flextable(a_data) %>% theme_vanilla() %>% bg(i = 1, part = "header", bg = "#548235") %>% color(i = 1, part = "header", color = "white") %>% bold(part = "header") %>% align(align = "center", part = "all") %>% autofit()
my_doc <- body_add_flextable(my_doc, value = ft_attr)
my_doc <- body_add_break(my_doc)
}
print(my_doc, target = path_out_word)
message("✅ 完美搞定！精美 Word 報告已成功匯出至:\n", path_out_word)
