portfolio_path <- "C:/Users/User/Desktop/Thesis_project/Output_M100/全期間/Output_SBXM/SBXM_Portfolio_M100.xlsx"
if (file.exists(portfolio_path)) {
# 讀取主要資料表
df_port <- read_excel(portfolio_path)
# --- Rf 處理：月資料計算 (假設欄位名稱包含 RF) ---
rf_col_name <- names(df_port)[grepl("RF|Risk_Free", names(df_port), ignore.case = TRUE)][1]
rf_monthly_raw <- df_port[[rf_col_name]]
# 計算 Rf 年化 (月平均 * 12, 月標準差 * sqrt(12))
rf_ret_annual <- mean(rf_monthly_raw, na.rm = TRUE) * 12 * 100
rf_sd_annual  <- sd(rf_monthly_raw, na.rm = TRUE) * sqrt(12) * 100
# --- DJI ETF 處理：直接尋找 Excel 中的數值 ---
# 由於你的 Excel 結構中 'Metric' 欄位名稱可能有誤，我們改用關鍵字搜尋
# 找出 DJI 所在的欄位
dji_col_idx <- which(grepl("DJI", names(df_port), ignore.case = TRUE))[1]
# 如果 DJI 的年化數據是在 Final_Report 的結構裡，
# 或者是 SBXM_Portfolio 的某個特定 Sheet
# 這裡假設 DJI 已經計算好並存在某個地方。
# 為了最安全起見，我從你原本的策略資料源 (df_sum) 中直接抓取 DJI 數據
# 通常 Final_Report_M100 裡面也會有 DJI 的資料
file_m100 <- file.path(base_path, "Output_M100", "全期間", "Final_Report_M100.xlsx")
df_ref <- read_excel(file_m100, sheet = "Performance_Summary")
# 抓取 DJI 列
dji_ret_val <- as.numeric(df_ref[df_ref[[1]] == "Annualized Return", "DJI"]) * 100
dji_sd_val  <- as.numeric(df_ref[df_ref[[1]] == "Annualized Std Dev", "DJI"]) * 100
benchmark_df <- data.frame(
Type = c("Risk-Free Rate", "DJI ETF"),
Return = c(rf_ret_annual, dji_ret_val),
Risk = c(rf_sd_annual, dji_sd_val)
)
}
# ==========================================
# 策略績效散布圖 - 讀檔精確校正版 (真實欄位)
# ==========================================
library(readxl)
library(tidyverse)
# 1. 設定基礎路徑與參數
base_path <- "C:/Users/User/Desktop/Thesis_project"
m_levels <- c("100", "101", "102", "103", "104", "105")
target_strategies <- c("IBXM", "SBXM", "CBXM")
all_data <- list()
# 2. 提取各策略資料
for (m in m_levels) {
file_path <- file.path(base_path, paste0("Output_M", m), "全期間", paste0("Final_Report_M", m, ".xlsx"))
if(!file.exists(file_path)) next
df_sum <- read_excel(file_path, sheet = "Performance_Summary")
m_val <- as.numeric(m) / 100
for (strat in target_strategies) {
strat_col <- ifelse(m == "100", paste0(strat, "(M=1)"), paste0(strat, "(M=", m_val, ")"))
if (!(strat_col %in% names(df_sum))) {
strat_col <- names(df_sum)[grepl(paste0("^", strat, "\\("), names(df_sum))][1]
}
if (!is.na(strat_col) && strat_col %in% names(df_sum)) {
n_y <- 0.1; n_x <- 0; h_adj <- 0.5
if (strat == "SBXM") { n_y <- ifelse(m == "101", 0.2, 0.1) }
if (strat == "CBXM") {
if (m == "100") { n_x <- 0.05; n_y <- -0.1; h_adj <- 1 }
else if (m == "101") { n_x <- 0.1; n_y <- -0.2; h_adj <- 1 }
else if (m %in% c("102", "103")) n_y <- 0.1
else n_y <- -0.1
}
all_data[[length(all_data) + 1]] <- data.frame(
Strategy = strat,
Moneyness = paste0("m=", m_val),
Return = as.numeric(df_sum[df_sum$Metric == "Annualized Return", strat_col]) * 100,
Risk = as.numeric(df_sum[df_sum$Metric == "Annualized Std Dev", strat_col]) * 100,
n_y = n_y, n_x = n_x, h_adj = h_adj
)
}
}
}
plot_df <- do.call(rbind, all_data)
# 3. 讀取基準點 (DIA 與 Rf) - 直接讀取特定分頁
portfolio_path <- "C:/Users/User/Desktop/Thesis_project/Output_M100/全期間/Output_SBXM/SBXM_Portfolio_M100.xlsx"
if (file.exists(portfolio_path)) {
# --- Rf 處理：讀取 Portfolio_Log 並加權計算 ---
df_log <- read_excel(portfolio_path, sheet = "Portfolio_Log")
# 判別天數當作權重 (Expiry_Date_Ref - Date_For_Port)
df_log$days <- as.numeric(difftime(df_log$Expiry_Date_Ref, df_log$Date_For_Port, units = "days"))
# 計算加權平均 (Excel內的 Avg_Rf 已經是 % 數，直接算即可)
rf_mean <- sum(df_log$Avg_Rf * df_log$days, na.rm = TRUE) / sum(df_log$days, na.rm = TRUE)
# 計算加權標準差
rf_sd <- sqrt(sum(df_log$days * (df_log$Avg_Rf - rf_mean)^2, na.rm = TRUE) / sum(df_log$days, na.rm = TRUE))
# --- DJI ETF 處理：讀取 Performance 工作表，直接抓數據 ---
df_perf <- read_excel(portfolio_path, sheet = "Performance")
dji_ret <- as.numeric(df_perf[df_perf$Metric == "Annualized Return", "DIA(ETF)"]) * 100
dji_sd  <- as.numeric(df_perf[df_perf$Metric == "Annualized Std Dev", "DIA(ETF)"]) * 100
benchmark_df <- data.frame(
Type = c("Risk-Free Rate", "DIA ETF"),
Return = c(rf_mean, dji_ret),
Risk = c(rf_sd, dji_sd)
)
} else {
stop("找不到 Excel 檔案，請再次確認路徑！")
}
# 4. 繪圖
p <- ggplot() +
# 虛線連結 Rf 與 DIA ETF
geom_segment(aes(x = benchmark_df$Risk[1], y = benchmark_df$Return[1],
xend = benchmark_df$Risk[2], yend = benchmark_df$Return[2]),
linetype = "longdash", color = "grey30", size = 0.6) +
geom_path(data = plot_df, aes(x = Risk, y = Return, color = Strategy, group = Strategy),
alpha = 0.3, linetype = "dashed") +
# 策略點位圖案 (16, 15, 17)
geom_point(data = plot_df, aes(x = Risk, y = Return, color = Strategy, shape = Strategy), size = 4) +
# 基準點位圖案 (18)
geom_point(data = benchmark_df, aes(x = Risk, y = Return),
shape = 18, size = 5, color = "black") +
geom_text(data = benchmark_df, aes(x = Risk, y = Return, label = Type),
vjust = -1.5, family = "serif", fontface = "italic", size = 3.5) +
geom_text(data = plot_df, aes(x = Risk, y = Return, label = Moneyness, hjust = h_adj),
nudge_y = plot_df$n_y, nudge_x = plot_df$n_x,
size = 3, fontface = "bold", family = "serif") +
scale_color_manual(values = c("IBXM" = "#6495ED", "SBXM" = "#CD5C5C", "CBXM" = "#FF8C00")) +
scale_shape_manual(values = c("IBXM" = 16, "SBXM" = 15, "CBXM" = 17)) +
theme_bw() +
theme(
text = element_text(family = "serif"),
plot.title = element_text(size = 14, face = "bold", hjust = 0.5),
legend.position = "bottom"
) +
labs(
title = "Strategic Risk-Return Profile with CML",
x = "Annualized Standard Deviation (%)",
y = "Annualized Return (%)"
)
# 5. 輸出
export_path <- file.path(base_path, "pictures", "Risk_Return_Scatter_Plot_Final_True.png")
if (!dir.exists(dirname(export_path))) dir.create(dirname(export_path), recursive = TRUE)
ggsave(export_path, plot = p, width = 11, height = 8, dpi = 300)
message("✅ 資料讀取成功：Rf 已採天數加權，DIA(ETF) 已直接引用現成數據。")
# ==========================================
# 策略績效散布圖 - Rf 年化邏輯最終精確版
# ==========================================
library(readxl)
library(tidyverse)
# 1. 設定基礎路徑與參數
base_path <- "C:/Users/User/Desktop/Thesis_project"
m_levels <- c("100", "101", "102", "103", "104", "105")
target_strategies <- c("IBXM", "SBXM", "CBXM")
all_data <- list()
# 2. 提取各策略資料
for (m in m_levels) {
file_path <- file.path(base_path, paste0("Output_M", m), "全期間", paste0("Final_Report_M", m, ".xlsx"))
if(!file.exists(file_path)) next
df_sum <- read_excel(file_path, sheet = "Performance_Summary")
m_val <- as.numeric(m) / 100
for (strat in target_strategies) {
strat_col <- ifelse(m == "100", paste0(strat, "(M=1)"), paste0(strat, "(M=", m_val, ")"))
if (!(strat_col %in% names(df_sum))) {
strat_col <- names(df_sum)[grepl(paste0("^", strat, "\\("), names(df_sum))][1]
}
if (!is.na(strat_col) && strat_col %in% names(df_sum)) {
n_y <- 0.1; n_x <- 0; h_adj <- 0.5
if (strat == "SBXM") { n_y <- ifelse(m == "101", 0.2, 0.1) }
if (strat == "CBXM") {
if (m == "100") { n_x <- 0.05; n_y <- -0.1; h_adj <- 1 }
else if (m == "101") { n_x <- 0.1; n_y <- -0.2; h_adj <- 1 }
else if (m %in% c("102", "103")) n_y <- 0.1
else n_y <- -0.1
}
all_data[[length(all_data) + 1]] <- data.frame(
Strategy = strat,
Moneyness = paste0("m=", m_val),
Return = as.numeric(df_sum[df_sum$Metric == "Annualized Return", strat_col]) * 100,
Risk = as.numeric(df_sum[df_sum$Metric == "Annualized Std Dev", strat_col]) * 100,
n_y = n_y, n_x = n_x, h_adj = h_adj
)
}
}
}
plot_df <- do.call(rbind, all_data)
# 3. 讀取基準點 (DIA 與 Rf)
portfolio_path <- "C:/Users/User/Desktop/Thesis_project/Output_M100/全期間/Output_SBXM/SBXM_Portfolio_M100.xlsx"
if (file.exists(portfolio_path)) {
# --- Rf 處理：讀取 Portfolio_Log 並加權計算 ---
df_log <- read_excel(portfolio_path, sheet = "Portfolio_Log")
# 判別天數當作權重 (Expiry_Date_Ref - Date_For_Port)
df_log$days <- as.numeric(difftime(df_log$Expiry_Date_Ref, df_log$Date_For_Port, units = "days"))
# 【重點修正】Avg_Rf 已經是年化數字，所以直接用天數做加權平均，不需要再乘 12！
rf_mean <- sum(df_log$Avg_Rf * df_log$days, na.rm = TRUE) / sum(df_log$days, na.rm = TRUE)
# 【重點修正】同理，標準差也直接取這組年化數字的加權標準差，不需要再乘 sqrt(12)！
rf_sd <- sqrt(sum(df_log$days * (df_log$Avg_Rf - rf_mean)^2, na.rm = TRUE) / sum(df_log$days, na.rm = TRUE))
# --- DIA ETF 處理：直接抓現成數據 ---
df_perf <- read_excel(portfolio_path, sheet = "Performance")
dji_ret <- as.numeric(df_perf[df_perf$Metric == "Annualized Return", "DIA(ETF)"]) * 100
dji_sd  <- as.numeric(df_perf[df_perf$Metric == "Annualized Std Dev", "DIA(ETF)"]) * 100
benchmark_df <- data.frame(
Type = c("Risk-Free Rate", "DIA ETF"),
Return = c(rf_mean, dji_ret),
Risk = c(rf_sd, dji_sd)
)
} else {
stop("找不到 Excel 檔案，請再次確認路徑！")
}
# 4. 繪圖
p <- ggplot() +
geom_segment(aes(x = benchmark_df$Risk[1], y = benchmark_df$Return[1],
xend = benchmark_df$Risk[2], yend = benchmark_df$Return[2]),
linetype = "longdash", color = "grey30", size = 0.6) +
geom_path(data = plot_df, aes(x = Risk, y = Return, color = Strategy, group = Strategy),
alpha = 0.3, linetype = "dashed") +
geom_point(data = plot_df, aes(x = Risk, y = Return, color = Strategy, shape = Strategy), size = 4) +
geom_point(data = benchmark_df, aes(x = Risk, y = Return),
shape = 18, size = 5, color = "black") +
geom_text(data = benchmark_df, aes(x = Risk, y = Return, label = Type),
vjust = -1.5, family = "serif", fontface = "italic", size = 3.5) +
geom_text(data = plot_df, aes(x = Risk, y = Return, label = Moneyness, hjust = h_adj),
nudge_y = plot_df$n_y, nudge_x = plot_df$n_x,
size = 3, fontface = "bold", family = "serif") +
scale_color_manual(values = c("IBXM" = "#6495ED", "SBXM" = "#CD5C5C", "CBXM" = "#FF8C00")) +
scale_shape_manual(values = c("IBXM" = 16, "SBXM" = 15, "CBXM" = 17)) +
theme_bw() +
theme(
text = element_text(family = "serif"),
plot.title = element_text(size = 14, face = "bold", hjust = 0.5),
legend.position = "bottom"
) +
labs(
title = "Risk-Return Scatter Plot",
x = "Annualized Standard Deviation (%)",
y = "Annualized Return (%)"
)
# 5. 輸出
export_path <- file.path(base_path, "pictures", "Risk_Return_Scatter_Plot_Final_True.png")
if (!dir.exists(dirname(export_path))) dir.create(dirname(export_path), recursive = TRUE)
ggsave(export_path, plot = p, width = 11, height = 8, dpi = 300)
message("✅ 完美修正！無風險利率已依天數正確加權。")
